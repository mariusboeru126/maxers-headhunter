# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=maxers_headhunter

# JWT secret used to sign login sessions - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret_string
# Separate long random secret used for time-bound encrypted job detail links
JOB_LINK_SECRET=change_this_to_a_different_long_random_secret_string

# Google reCAPTCHA v2 Checkbox keys (create them at https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Gmail / Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
